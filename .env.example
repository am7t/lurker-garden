# Copy to .env. Enter credentials locally; never share or commit .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Channel login name, without # or a URL.
TWITCH_CHANNEL=your_channel
PORT=3000

# Multiply points from presence ticks and watering; cadence/cooldowns use real time.
GROWTH_SPEED=1
# Development only: treat the garden as live, but still require real Twitch chat presence.
DEV_FORCE_LIVE=false
